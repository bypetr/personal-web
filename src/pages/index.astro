---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import avatar from '@/assets/avatar.png';
import BaseLayout from '@/layouts/base-layout.astro';
import ProjectItem from '@/components/project-item.astro';
import ThemeToggle from '@/components/theme-toggle.tsx';
import { LINKS, SITE } from '@/consts';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout>
  <header class="flex items-start justify-between gap-4">
    <Image
      src={avatar}
      alt=""
      width={112}
      height={112}
      densities={[2]}
      loading="eager"
      class="size-28 rounded-2xl border border-line object-cover"
    />
    <ThemeToggle client:load />
  </header>

  <h1 class="mt-8 text-4xl font-bold tracking-tight">
    Hey, I&apos;m {SITE.name} <span aria-hidden="true">👋</span>
  </h1>

  <div class="mt-6 space-y-4 text-lg leading-relaxed text-ink-muted">
    <p>
      Experienced developer, learning to actually ship.{' '}
      <span aria-hidden="true">🚢</span>
    </p>
    <p>
      I build what I need and share what works.{' '}
      <span aria-hidden="true">🥋</span>
    </p>
  </div>

  {
    LINKS.length > 0 && (
      <nav class="mt-8 flex flex-wrap gap-5 text-ink-muted">
        {LINKS.map((link) => (
          <a
            href={link.href}
            rel="noopener"
            class="underline underline-offset-4 transition-colors hover:text-ink"
          >
            {link.label}
          </a>
        ))}
      </nav>
    )
  }

  <section class="mt-16">
    <h2 class="text-xs font-medium tracking-widest text-ink-muted uppercase">
      Things I&apos;ve built
    </h2>

    {
      projects.length > 0 ? (
        <ul class="mt-2">
          {projects.map((project) => (
            <ProjectItem project={project} />
          ))}
        </ul>
      ) : (
        <p class="mt-4 text-ink-muted">
          Add a markdown file to <code>src/content/projects/</code>.
        </p>
      )
    }
  </section>
</BaseLayout>
